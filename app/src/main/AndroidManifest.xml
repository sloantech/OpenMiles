<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Only used if the person turns on "Automatic drive detection" in Settings.
        The app asks for these at that moment, never before.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission
        android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Only used if the person turns on "Start when my car's Bluetooth connects". The app reads
        the list of devices already paired with the phone so the person can pick their car. It
        never scans for devices and never connects to anything.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Privacy promise: OpenMiles never connects to the internet. This line removes the
        INTERNET permission even if a library we use asks for it. The build also checks it.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenMiles">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Drive signals from Google Play services. Other apps cannot reach it. -->
        <receiver
            android:name=".tracking.DetectionReceiver"
            android:exported="false" />

        <!--
            Car Bluetooth connect and disconnect signals. Only the phone's Bluetooth system holds
            the permission named here, so other apps cannot send fake signals. One receiver is
            active on Android 12 and newer, the other on older versions.
        -->
        <receiver
            android:name=".tracking.CarBluetoothReceiver"
            android:enabled="@bool/car_bt_modern"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".tracking.CarBluetoothReceiverLegacy"
            android:enabled="@bool/car_bt_legacy"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- The Business and Personal buttons on the drive-ended notification. Other apps cannot reach it. -->
        <receiver
            android:name=".tracking.ClassifyActionReceiver"
            android:exported="false" />

        <!-- The weekly "drives to classify" reminder. Other apps cannot reach it. -->
        <receiver
            android:name=".tracking.ReminderReceiver"
            android:exported="false" />

        <!-- Turns detection back on after a restart or update. Only the system can send these. -->
        <receiver
            android:name=".tracking.BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
